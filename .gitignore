# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.venv/
venv/

# VS Code
.vscode/

# Windows
Thumbs.db
Desktop.ini

# Logs
*.log

# Maxroll data-decoder cache (large downloaded/fetched JSON, regenerable)
.cache/

# Build
build/
dist/

# PyInstaller (diablo4companion.spec is intentionally committed - W2 phase)
*.spec
!diablo4companion.spec

# User-provided Unique item icons (src/item_icon_assets.py) - the
# user's own files, never committed to this public repo. Keep the
# folder's README so `git status` shows where to put them.
assets/items/uniques/*
!assets/items/uniques/README.md
# Item image cache - copies of API-served images, never canonical
cache/
tests/_image_cache/

# Local Data API address - configuration, never committed (see src/api_config.py)
api_url.txt
